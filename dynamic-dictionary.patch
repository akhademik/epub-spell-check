--- /dev/null
+++ b/src/utils/dict-admin.ts
@@ -0,0 +1,48 @@
+export type DictSourceName = "vn" | "non-vn" | "custom" | "names"
+
+export interface DictUpdateResult {
+  name: DictSourceName
+  action: "add" | "remove"
+  addedCount: number
+  totalCount: number
+  updatedAt: string
+}
+
+/**
+ * Adds or removes words from a dictionary via the /api/dict/:name endpoint
+ * (Cloudflare Function backed by KV). Requires the admin token configured
+ * as the ADMIN_TOKEN secret on the Cloudflare Pages project.
+ */
+export async function updateDictionaryWords(
+  dictName: DictSourceName,
+  words: string[],
+  token: string,
+  action: "add" | "remove" = "add"
+): Promise<DictUpdateResult> {
+  const res = await fetch(`/api/dict/${dictName}`, {
+    method: "POST",
+    headers: {
+      "content-type": "application/json",
+      authorization: `Bearer ${token}`
+    },
+    body: JSON.stringify({ words, action })
+  })
+
+  if (res.status === 401) {
+    throw new Error("Mã truy cập (token) không đúng.")
+  }
+  if (!res.ok) {
+    let detail = ""
+    try {
+      const body = (await res.json()) as { error?: string }
+      detail = body.error ?? ""
+    } catch {
+      /* intentional no-op */
+    }
+    throw new Error(
+      `Không thể cập nhật từ điển (mã lỗi ${res.status}). ${detail}`.trim()
+    )
+  }
+
+  return (await res.json()) as DictUpdateResult
+}
