{
  "name": "epub-spell-checker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check .",
    "knip": "knip",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:smoke": "vitest run tests/smoke.test.ts",
    "test:regression": "vitest run tests/regression.test.ts",
    "test:watch": "vitest",
    "dicts:clean": "tsx scripts/clean-dicts.ts",
    "dicts:pull-from-kv": "tsx scripts/pull-dicts-from-kv.ts",
    "dicts:push-to-kv": "./scripts/seed-kv.sh ab6a4a72cbf2462f8d8b1074e44db5e7 --remote",
    "postinstall": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm dicts:pull-from-kv"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "autoprefixer": "^10.0.0",
    "jsdom": "^30.0.1",
    "knip": "^6.33.0",
    "postcss": "^8.0.0",
    "simple-git-hooks": "^2.14.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^3.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  }
}
